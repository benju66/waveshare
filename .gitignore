# macOS
.DS_Store

# Python (tools/capture.py has no other deps, but keep this clean)
__pycache__/
*.pyc
.venv/

# ESP-IDF build output and local config (sdkconfig.defaults is the source of truth)
fluidbox/build/
fluidbox/sdkconfig
fluidbox/sdkconfig.old
fluidbox/dependencies.lock

# Fetched by the IDF component manager from idf_component.yml
fluidbox/managed_components/

# Waveshare demo sparse clone used only during bring-up (~700 MB)
vendor/

# Host preview: rendered frames, and the copy of render.c it builds from
tools/preview/out/
tools/preview/render_host.c

# Local tooling config
.claude/

# Wi-Fi credentials (a secrets.h.example is committed instead)
fluidbox/main/secrets.h
